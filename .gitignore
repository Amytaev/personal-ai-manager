# Secrets - never commit
.env

# Local runtime data
data/*.db
data/.instance.lock
logs/*.log
logs/*.log.*

# Failure-diagnostic screenshots (agents/teams/agent.py,
# scripts/teams_diagnose_reauth.py) - can show real account/tenant info
# on the Microsoft login screen, never a password, but still not
# something to commit.
data/teams_last_failure.png
data/teams_diagnose_*.png
data/sso_diagnose_*.png

# Keep folder structure without committing their contents
!data/.gitkeep
!logs/.gitkeep

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/

# Playwright persistent browser profiles (Phase 5 Teams, Phase 6
# VALORANT/Stack B) - contain real session cookies (Microsoft, Riot via
# Stack B). The old bare "browser_profile/" pattern below never actually
# matched either real directory name (teams_browser_profile/,
# valorant_browser_profile/) - kept for safety, but the glob below is
# the one that actually covers them, and any future *_browser_profile/
# directory added under data/.
browser_profile/
data/*browser_profile*/
