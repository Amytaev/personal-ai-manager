# Telegram (Phase 3) - private single-user bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Weather (Phase 4)
WEATHER_LOCATION=
WEATHER_API_KEY=

# LLM abstraction (used by llm/provider.py).
# Powers plain-text chat with Claude in Telegram (any message that isn't
# a slash command) and, later in Phase 7, the AI Manager's automatic
# briefing summaries.
# Get an API key at https://console.anthropic.com/settings/keys - this is
# a separate Anthropic account/key from claude.ai, billed per request.
# Leave LLM_API_KEY empty to disable both features (NullProvider is used,
# chat messages get a reply telling you to set this instead of failing).
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=

# Scheduler intervals (minutes)
TEAMS_INTERVAL_MINUTES=60
WEATHER_INTERVAL_MINUTES=60
VALORANT_INTERVAL_MINUTES=120
SSO_INTERVAL_MINUTES=120
BRIEFING_HOUR=8

# Teams course filtering (Phase 5) - comma-separated course names
INCLUDED_COURSES=
EXCLUDED_COURSES=

# Teams assignments due before this ISO date are dropped by TeamsAgent
# before anything is saved to the DB - old/stale-semester noise never
# enters the system at all. Defaults to the start of the current
# semester; change this at the start of a new one.
TEAMS_MIN_DUE_DATE=2026-09-01T00:00:00Z

# utils/academic_calendar.py's anchor for teaching week 1 (/week command,
# telegram_bot/handlers.py) - the semester's real first day. Per Desae
# directly (2026-09-27): teaching week 1 = this date through the Sunday
# before the next Monday, week 2 onward = real Monday-Sunday calendar
# weeks, 15 teaching weeks total. Change this at the start of a new
# semester, same as TEAMS_MIN_DUE_DATE above (kept as a separate var on
# purpose - see config.py's comment).
SEMESTER1_WEEK1_START=2026-09-01T00:00:00Z

# Storage
DATA_RETENTION_DAYS=30
DATABASE_PATH=data/agent.db
LOG_DIR=logs
LOCK_FILE_PATH=data/.instance.lock
WISHLIST_PATH=config/wishlist.json
TEAMS_PROFILE_PATH=data/teams_browser_profile
# Persistent Stack B (stackb.net) login session (Phase 6, VALORANT
# Agent) - set up once with `python -m scripts.valorant_login_setup`.
VALORANT_PROFILE_PATH=data/valorant_browser_profile
# Persistent SSO (sso.satbayev.university) login session (Этап B, SSO
# Agent) - set up once with `python -m scripts.sso_login_setup`. Never
# mixed with TEAMS_PROFILE_PATH/VALORANT_PROFILE_PATH above.
SSO_PROFILE_PATH=data/sso_browser_profile
